# Copie este arquivo para ".env" e preencha os valores reais.
# NUNCA suba o arquivo ".env" real para o GitHub.

# String de conexão do Postgres (Neon, Supabase, Render Postgres, etc.)
# Formato: postgresql://usuario:senha@host:5432/nome_do_banco?sslmode=require
DATABASE_URL=postgresql://usuario:senha@host:5432/ajofer_dashboard

# Coloque "false" apenas se estiver usando um Postgres local sem SSL
DATABASE_SSL=true

# Segredo usado para assinar os tokens de login (JWT). Troque por um valor
# aleatório e longo, por exemplo gerado com: openssl rand -hex 32
JWT_SECRET=troque_este_valor_por_algo_aleatorio_e_longo

# URL do site (frontend) que terá permissão de chamar esta API.
# Exemplo: https://ajofer-dashboard.netlify.app
# Pode listar mais de uma, separadas por vírgula.
FRONTEND_ORIGIN=

PORT=3000
